# =============================================================================
# Yuno Agent Platform — environment variables (copy to .env)
# =============================================================================

# --- Application ---
APP_ENV=development
DEBUG=true
API_VERSION=0.1.0
OPENAPI_ENABLED=true
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=604800

# --- Database (required) ---
# Schema: app (see Alembic).
# Docker Compose overrides this for api/worker to the bundled postgres service.
# Local API without Docker (postgres via compose, host port 5433): postgresql+psycopg2://yuno:yuno@localhost:5433/yuno
DATABASE_URL=postgresql+psycopg2://yuno:yuno@localhost:5433/yuno

# --- Default admin (seeded when users table is empty) ---
ADMIN_EMAIL=admin@yuno.local
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Platform Admin

# --- Public URL (password reset links) ---
APP_BASE_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_HOURS=24

# --- Redis + Celery ---
# Docker Compose overrides REDIS_URL to redis://redis:6379/0 for api/worker
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- LLM runtime (defaults: real OpenAI + live tools) ---
# No OpenAI key? The app automatically uses mock LLM responses (see RunService._resolve_mock).
OPENAI_API_KEY=
# Set both true to force offline mocks even when OPENAI_API_KEY is set.
RUNTIME_MOCK_LLM=false
RUNTIME_MOCK_TOOLS=false

# --- Telegram (required external channel for challenge demo) ---
# Create a bot via @BotFather; use polling for local docker compose demos.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=true

# --- SMTP (optional - password reset emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Dev pipeline: GitHub (public repo + push from worker) ---
# Classic PAT: https://github.com/settings/tokens — enable scope "repo" (or "public_repo" only).
# Fine-grained: Administration + Contents (read/write) on target repos.
# GITHUB_OWNER must be your GitHub username OR an org name the token can create repos in.
# If you use an org, authorize the token for SSO on that org (Settings → SSO).
# Droplets clone without a browser — repos must be public (auto-set after publish) or
# deploy uses this token embedded in cloud-init (visible in DO metadata; demo only).
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username

# --- Dev pipeline: DigitalOcean (create droplet via API) ---
# Create a token at https://cloud.digitalocean.com/account/api/tokens — read+write
DO_API_TOKEN=
DO_REGION=blr1
DO_SIZE=s-1vcpu-1gb
DO_IMAGE=ubuntu-22-04-x64

# --- Dev pipeline: temporary droplet root password ---
# Used only for demo droplets; generate a long random string.
# The droplet is destroyed within the hour — never use a real password.
DEPLOY_ROOT_PASSWORD=

# --- Static paths (Docker Compose sets these) ---
# UI_ASSETS_DIR=/ui-assets
# UI_JS_DIR=/ui-js
